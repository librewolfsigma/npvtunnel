<UserControl x:Class="NpvTunnel.App.Pages.HomePage"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,14">
      <StackPanel HorizontalAlignment="Center">
        <TextBlock x:Name="StatusText" Text="Disconnected" FontSize="34"
                    FontWeight="Bold" HorizontalAlignment="Center"
                    Foreground="{StaticResource TextSecondary}" />
        <TextBlock x:Name="StatusDetail" Margin="0,8,0,0"
                    Style="{StaticResource Muted}"
                    Text="The tunnel is not running"
                    HorizontalAlignment="Center" />
        <Button x:Name="ConnectButton" Content="CONNECT"
                Style="{StaticResource BigConnectButton}" Margin="0,22,0,0"
                Click="OnConnectClick" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Style="{StaticResource CardBorder}">
      <StackPanel>
        <TextBlock Text="Current profile" Style="{StaticResource Heading}" />
        <TextBlock x:Name="ProfileName" Text="-" FontSize="18" FontWeight="SemiBold" />
        <TextBlock x:Name="ProfileEndpoint" Style="{StaticResource Muted}"
                    Margin="0,4,0,0" Text="select a profile on the Configs page" />
        <TextBlock x:Name="ImportSummary" Style="{StaticResource Muted}"
                    Margin="0,10,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,14,0,0">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="SOCKS5 inbound:" Style="{StaticResource Muted}" />
        <TextBlock Text="127.0.0.1:2080" Margin="6,0,18,0"
                    Foreground="{StaticResource Accent}" />
        <TextBlock Text="Bind is loopback-only; sharing requires explicit consent."
                    Style="{StaticResource Muted}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
