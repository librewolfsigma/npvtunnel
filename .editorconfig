root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
indent_size = 4

[*.py]
indent_size = 4

[*.toml]
indent_size = 4

[*.md]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false

[Cargo.lock]
indent_style = unset
indent_size = unset

[Makefile]
indent_style = tab

# Vendored font license texts keep their original upstream formatting.
[crates/npvt-gui/assets/fonts/*.txt]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false
